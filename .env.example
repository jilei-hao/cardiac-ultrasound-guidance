POSE_EST_IMG_WEIGHTS=/Users/jileihao/dev/paradigm/cardiac-ultrasound-guidance/weights/pose-est-img_v1.pth
LVEF_WEIGHTS=/Users/jileihao/dev/paradigm/cardiac-ultrasound-guidance/weights/echonet_v1.pt
4CH_WEIGHTS=/Users/jileihao/dev/paradigm/cardiac-ultrasound-guidance/weights/4ch-seg_v1.pt
