
# Example .env file for storing model weights paths
# Copy this file to .env and modify the paths as needed
LANDMARK_WEIGHTS=/Users/jileihao/dev/paradigm/cardiac-ultrasound-guidance/weights/landmark-prediction_v1.pth
POSE_EST_WEIGHTS=/Users/jileihao/dev/paradigm/cardiac-ultrasound-guidance/weights/pose-est-256x256_v1.pth
POSE_EST_IMGLMK_WEIGHTS=/Users/jileihao/dev/paradigm/cardiac-ultrasound-guidance/weights/pose-est-imglmk_v1.pth
POSE_EST_IMG_WEIGHTS=/Users/jileihao/dev/paradigm/cardiac-ultrasound-guidance/weights/pose-est-img_v1.pth
LVEF_WEIGHTS=/Users/jileihao/dev/paradigm/cardiac-ultrasound-guidance/weights/echonet_v1.pt
4CH_WEIGHTS=/Users/jileihao/dev/paradigm/cardiac-ultrasound-guidance/weights/4ch-seg_v1.pt
ROTATION_PREDICTION_WEIGHTS=/Users/jileihao/dev/paradigm/cardiac-ultrasound-guidance/weights/rotation-prediction_v1.pt
ROTATION_PREDICTION_CONFIG=/Users/jileihao/dev/paradigm/cardiac-ultrasound-guidance/src/inference/rotation/config.json

# UI assets
PROBE_MESH_PATH=/Users/jileihao/dev/vigil-developer/cardiac-ultrasound-guidance/src/ui/assets/probe_clarius-pahd3_lowres.obj
LANDMARK_COLOR_LEGEND_PNG_PATH=/home/jileihao/dev/aph-dev/cardiac-ultrasound-guidance/assets/4ch-legend_static_v1.png
GUIDANCE_WIDGET_LEGEND_PNG_PATH=/home/jileihao/dev/aph-dev/cardiac-ultrasound-guidance/assets/guidance-widget-legend_v1.png
REFERENCE_BODY_PATH=/Users/jileihao/dev/vigil-developer/cardiac-ultrasound-guidance/src/ui/assets/body_model.obj

# USGR probe-pose (standard-view) guidance assets
PROBE_POSE_WEIGHTS=/Users/jileihao/data/vigil/__demo_weights/ema_11000.pth
PROBE_POSE_NORM_STATS=/Users/jileihao/data/vigil/__demo_weights/normalization_statistics.pth
PROBE_POSE_DINO_WEIGHTS=/Users/jileihao/data/vigil/__demo_weights/dinov3_vitl16_pretrain_lvd1689m-8aa4cbdd.pth
# Encoder variant for the checkpoint above. ema_11000 (0610 invivo run) = vitl16;
# the older demo checkpoints (ema_9000/21000) = dinov3_convnext_base (the default).
PROBE_POSE_DINO_MODEL=dinov3_vitl16
PROBE_POSE_IMAGE_SIZE=512
# HUD view names default to the invivo mapping (PLAX, PSAX, A4C, A2C, SC4C,
# SCIVC). Only set PROBE_POSE_VIEW_SET=simulated for a legacy convnext checkpoint.
# H-flip input to the training chirality (LV-on-left). ema_11000 is
# flip-equivariant: feeding LV-on-right rotates its prediction 180 deg about
# probe X (verified). Set 'true' for LIVE CLARIUS/CUSG frames (LV-on-right);
# keep 'false' for the USGR invivo reproduction data (already LV-on-left).
PROBE_POSE_MIRROR_INPUT=false

# USGR quality-score ("traffic light v2") classifier.
# Optional ALTERNATIVE to the legacy ResNet18 pose classifier; both stay loaded
# and you toggle between them live in guidance_ui with the 'm' hotkey (default
# is legacy). Unset QUALITY_SCORE_WEIGHTS -> the model isn't built and 'm' is a
# no-op. ScoreTransformer = frozen DINOv3 encoder + a scalar head (reuses the
# same vendored TransformerHead as probe_pose).
QUALITY_SCORE_WEIGHTS=/Users/jileihao/data/vigil/__demo_weights/new_traffic_light_ema5000.pth
# DINOv3 backbone weights. If unset, falls back to PROBE_POSE_DINO_WEIGHTS
# (same dinov3_vitl16 file).
QUALITY_SCORE_DINO_WEIGHTS=/Users/jileihao/data/vigil/__demo_weights/dinov3_vitl16_pretrain_lvd1689m-8aa4cbdd.pth
# Encoder variant + input size the score checkpoint was trained with. The
# delivered checkpoint reuses the probe_pose backbone (dinov3_vitl16 @ 512,
# 1024-d, num_heads=16). Override only if the USGR config.yaml disagrees.
QUALITY_SCORE_DINO_MODEL=dinov3_vitl16
QUALITY_SCORE_IMAGE_SIZE=512
QUALITY_SCORE_NUM_HEADS=16
# H-flip input to the training chirality (LV-on-left), like PROBE_POSE_MIRROR_INPUT.
# Reference visualizer does no flipping, so default 'false'; try 'true' if the
# score looks inverted on live data.
QUALITY_SCORE_MIRROR_INPUT=false
# Traffic-light thresholds on the raw score (red < red_below <= yellow <
# green_above <= green). USGR maps score in [-3, 3] with yellow centred at 0.
QUALITY_SCORE_RED_BELOW=-1.0
QUALITY_SCORE_GREEN_ABOVE=1.0
# Smoothing window: the border colour uses the MEAN of the last N scores (the
# HUD still shows the raw per-frame score). Larger = steadier but laggier; 1
# disables smoothing. Default 15.
QUALITY_SCORE_POOL_SIZE=15